# Sunucu portu (geliştirmede Vite bu porta proxy yapar)
PORT=3001
# Panel giriş bilgileri — mutlaka değiştirin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=d2fda.admin
# Oturum çerezini imzalamak için uzun, rastgele bir değer
SESSION_SECRET=uzun-rastgele-bir-deger-yazin
# Veritabanı ve yükleme klasörleri (opsiyonel)
DATA_DIR=./data
UPLOAD_DIR=./uploads
# 3D model indirme (m2icondb): Python 3.10+ ve pip install -r services/model-downloader/requirements.txt
# MODEL_DOWNLOADER_PYTHON=C:\path\to\python.exe
# Oyunculara açık item wiki sayfaları (/wiki). Kapatmak için false yapın.
PUBLIC_WIKI=true
# Oyun sunucusunun yayınlanmış veriyi çektiği /api/game uç noktalarının anahtarı (boşsa kapalı).
# Oyunda aynı değer KALE2_GAME_TOKEN olarak verilir. Üretmek için: openssl rand -hex 32
GAME_API_TOKEN=
# Linkten içe aktarmada metin2alerts.com dışında izin verilecek ek alan adları (virgülle; ör. ikonların bulunduğu bir CDN)
# IMPORT_ALLOWED_HOSTS=cdn.ornek.com
# Anasayfa hero MP4 (Vite build — Cloudflare R2 public URL veya /assets/hero.mp4)
# R2: bucket → Public access / custom domain, CORS GET + site origin
# VITE_HERO_VIDEO_URL=https://media.ornek.com/kale2/hero.mp4
# VITE_HERO_VIDEO_POSTER=https://media.ornek.com/kale2/hero-poster.jpg

# Launcher patch dosyaları. Yerelde varsayılan: ./patches
# Üretimde deploy'lar arasında korunan, yalnızca patch dosyalarının olduğu dizini kullanın.
# PATCH_DIR=/var/www/kale2/shared/patches
