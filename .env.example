# Sunucu portu (geliştirmede Vite bu porta proxy yapar)
PORT=3001
# Panel giriş bilgileri — mutlaka değiştirin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=d2fda.admin
# Oturum çerezini imzalamak için uzun, rastgele bir değer
SESSION_SECRET=uzun-rastgele-bir-deger-yazin
# Veritabanı ve yükleme klasörleri (opsiyonel)
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Oyunculara açık item wiki sayfaları (/wiki). Kapatmak için false yapın.
PUBLIC_WIKI=true
# Linkten içe aktarmada metin2alerts.com dışında izin verilecek ek alan adları (virgülle; ör. ikonların bulunduğu bir CDN)
# IMPORT_ALLOWED_HOSTS=cdn.ornek.com
